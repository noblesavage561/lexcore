{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexcore.bbaservices.com/schemas/audit/audit-event",
  "title": "AuditEvent",
  "description": "Append-only audit log event — never deleted or modified",
  "type": "object",
  "required": ["event_id", "agent_id", "tool_called", "data_accessed", "client_id", "outcome", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "agent_id": { "type": "string" },
    "tool_called": { "type": "string" },
    "data_accessed": { "type": "array", "items": { "type": "string" } },
    "client_id": { "type": "string", "format": "uuid" },
    "matter_id": { "type": "string", "format": "uuid" },
    "approval_ref": { "type": "string", "format": "uuid" },
    "outcome": { "type": "string", "enum": ["success", "failure", "blocked", "pending_approval"] },
    "error_message": { "type": "string" },
    "input_summary": { "type": "string" },
    "output_summary": { "type": "string" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "tokens_used": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
