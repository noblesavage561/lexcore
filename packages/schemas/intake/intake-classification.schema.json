{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexcore.bbaservices.com/schemas/intake/intake-classification",
  "title": "IntakeClassification",
  "description": "Output schema for Agent 1 — Intake Classifier",
  "type": "object",
  "required": ["thread_id", "channel", "domain", "urgency", "risk_level", "requires_human_review", "key_entities", "extracted_deadlines", "source_refs"],
  "additionalProperties": false,
  "properties": {
    "thread_id": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["email", "webhook", "portal", "api"] },
    "domain": {
      "type": "string",
      "enum": ["legal", "tax", "real_estate", "heritage", "political", "consumer_credit", "international", "business", "unknown"]
    },
    "urgency": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "risk_level": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "requires_human_review": { "type": "boolean" },
    "key_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["person", "organization", "property", "statute", "case", "jurisdiction"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "extracted_deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "date"],
        "properties": {
          "description": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "statute_ref": { "type": "string" }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "client_id": { "type": "string", "format": "uuid" },
    "matter_id": { "type": "string", "format": "uuid" },
    "classified_at": { "type": "string", "format": "date-time" }
  }
}
